# IDE
/.idea/
/.vscode/
/.claude/
/.qoder/
/.tmp/

# 编译产物
/dist/
good-review-master-windows*
__debug_bin*
__pycache__/

# 配置文件（含真实配置，不提交；*_example.yaml 作为模板会提交）
/config.yaml
/prompt_system.yaml
/prompt_custom.yaml
# 旧版本工作空间目录（已废弃：工作空间不再有目录，仅防残留被误提交）
/workspaces/
# 本地档案库（消息/锚点/人格等，单库按 workspace_id 区分账号）
/state.db
/state.db-wal
/state.db-shm
# 密钥文件：单独一份、权限 0600，绝不能进版本库
/secret.yaml

# 日志
/log/
/web/frontend/node_modules/
/web/frontend/package-lock.json
/web/frontend/dist/
/web/server/static/frontend/

# E2E 测试产物
/tests/e2e/node_modules/
/tests/e2e/.workdir/
/tests/e2e/playwright-report/
/tests/e2e/test-results/

# AstrBot 运行时数据（误提交过，Good-Review 不读取）
/data/
